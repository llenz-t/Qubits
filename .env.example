# .env.example
# AttendEase application environment configuration

# Supabase project (Project Settings -> API). The anon/public key is safe for
# the frontend; never put the service role key here (that belongs only in
# backend/.env). Leave these unset to run the app fully in demo/mock-data mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the Express backend (see backend/) that serves the daily
# attendance upload pipeline, session cancellation, and dashboard endpoints.
VITE_API_BASE_URL=http://localhost:4000/api
