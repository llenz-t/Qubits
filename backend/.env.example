# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key - server-side ONLY, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Express server
PORT=4000
# Comma separated list of origins allowed to call this API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3000

# Max upload sizes (bytes)
MAX_EXCEL_UPLOAD_BYTES=10485760
MAX_PDF_UPLOAD_BYTES=5242880
