# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same Supabase project, exposed to the browser via Vite (VITE_ prefix required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Upload limits enforced by backend/src/middleware/upload.js
MAX_EXCEL_UPLOAD_BYTES=5242880
MAX_PDF_UPLOAD_BYTES=5242880

# Demo Mode - simple role-based auth, no JWT/session tokens
DEMO_MODE=true

# Port the Express server listens on (defaults to 3000 if unset)
PORT=3000
